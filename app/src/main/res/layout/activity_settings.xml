<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootSettings"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_back"
        app:title="@string/menu_settings"
        app:titleCentered="false"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIconTint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_library_status"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:paddingTop="24dp"
        android:paddingBottom="4dp" />

    <TextView
        android:id="@+id/txtStatusSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_scanning_subtitle"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:paddingBottom="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtProgress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressScanning"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnRescan"
        style="@style/Widget.MapPlayer.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_rescan_library"
        android:layout_marginTop="32dp" />

    <Button
        android:id="@+id/btnOpenLog"
        style="@style/Widget.MapPlayer.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="@string/settings_open_log"
        android:layout_marginTop="32dp" />

    <FrameLayout
        android:id="@+id/settingsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp" />

</LinearLayout>

