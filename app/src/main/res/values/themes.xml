<resources>

    <style name="Theme.MapPlayer" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:forceDarkAllowed">true</item>

        <!-- Force dark text/icons on light surfaces -->
        <item name="colorOnSurface">@android:color/black</item>
        <item name="colorOnPrimary">@android:color/black</item>
    </style>

    <style name="MapPlayer.PopupMenu" parent="ThemeOverlay.Material3.Light">
        <item name="colorOnSurface">@android:color/black</item>
        <item name="colorSurface">@android:color/white</item>
    </style>

</resources>
